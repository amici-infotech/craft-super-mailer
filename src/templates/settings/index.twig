{% extends "_layouts/cp" %}
{% import "_includes/forms" as forms %}

{% set title = "Settings"|t('super-mailer') %}
{% set fullPageForm = true %}
{% set selectedNavItem = 'super-mailer' %}
{% set selectedSubnavItem = 'settings' %}
{% set crumbs = [
    { label: "Super Mailer"|t('super-mailer'), url: cpUrl('super-mailer/notifications') },
] %}

{% block content %}
    {{ actionInput('super-mailer/settings/save') }}
    {{ redirectInput('super-mailer/settings') }}

    {{ forms.textField({
        first: true,
        label: "Plugin Name"|t('super-mailer'),
        instructions: "The label shown in the control panel navigation."|t('super-mailer'),
        id: 'pluginName',
        name: 'pluginName',
        value: settings.pluginName,
        errors: settings.getErrors('pluginName'),
        required: true
    }) }}

    {{ forms.textField({
        label: "Email Log Retention"|t('super-mailer'),
        instructions: "Automatically purge email logs older than this many days after each send. Set to 0 to disable automatic purging."|t('super-mailer'),
        id: 'emailLogRetentionDays',
        name: 'emailLogRetentionDays',
        type: 'number',
        min: 0,
        value: settings.emailLogRetentionDays,
        errors: settings.getErrors('emailLogRetentionDays'),
        unit: "days"|t('super-mailer')
    }) }}
{% endblock %}
